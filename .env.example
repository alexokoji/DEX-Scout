# ── Core ─────────────────────────────────────────────────────────────
# MongoDB. `npm run dev` starts an embedded local single-node replica set on :27117 if this points at 127.0.0.1:27117.
# A replica set (even single-node) is required: multi-document transactions (capital-safety locking) need one.
MONGODB_URI="mongodb://127.0.0.1:27117/dexscout?replicaSet=rs0"
# Optional: overrides the database name from MONGODB_URI's path (handy for Atlas connection strings)
MONGODB_DB=""
# Secret that authorises /api/cron/* (Vercel Cron sends it as a Bearer token). Min 16 chars. Required on Vercel.
CRON_SECRET=""
# Session signing secret (min 16 chars). Generate: openssl rand -base64 32. REQUIRED in production.
AUTH_SECRET="replace-me-with-a-long-random-string"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ── Provider mode ────────────────────────────────────────────────────
# true  = deterministic simulated market, DEX and wallet data (no external credentials needed)
# false = real providers below (DexScreener/GeckoTerminal market data, Jupiter swaps, Solana RPC)
MOCK_PROVIDER=true

# There is no paper/simulated trading mode -- every trade is LIVE. Trading is OFF unless this is true
# AND MOCK_PROVIDER=false (so mock/synthetic data can never drive a real trade).
LIVE_TRADING_ENABLED=false

# ── Solana ───────────────────────────────────────────────────────────
SOLANA_RPC_URL="https://api.mainnet-beta.solana.com"
SOLANA_WS_URL=""
# Optional: RPC URL exposed to the browser for wallet transaction sending (use a key restricted to your domain)
NEXT_PUBLIC_SOLANA_RPC_URL=""

# ── EVM chains (Ethereum, Base, BNB Chain, Arbitrum, Polygon) ───────────
# Server-side JSON-RPC endpoints (public defaults are used when blank; use a keyed provider in production)
ETHEREUM_RPC_URL=""
BASE_RPC_URL=""
BSC_RPC_URL=""
ARBITRUM_RPC_URL=""
POLYGON_RPC_URL=""
# 0x Swap API key: required for LIVE swaps on EVM chains
ZEROX_API_KEY=""

# ── DEX aggregator (Jupiter, Solana) ─────────────────────────────────
DEX_PROVIDER_URL="https://lite-api.jup.ag/swap/v1"
DEX_PROVIDER_API_KEY=""

# ── Market data (DexScreener by default; key optional) ───────────────
MARKET_DATA_URL="https://api.dexscreener.com"
MARKET_DATA_API_KEY=""

# ── AI analysis (optional; without a key a deterministic rules-based summariser is used) ──
AI_API_KEY=""
AI_MODEL="claude-sonnet-5"

# ── Workers ──────────────────────────────────────────────────────────
SCANNER_INTERVAL_SECONDS=30
MONITOR_INTERVAL_SECONDS=15
# ── Optional integrations ─────────────────────────────────────────────
# Birdeye: real holder counts/growth in real-data mode
BIRDEYE_API_KEY=""
# Upstash Redis REST: shared rate limiting across multiple server instances
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""
