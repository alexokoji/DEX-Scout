generator client {
  provider      = "prisma-client-js"
  // rhel-openssl-3.0.x is the Vercel/AWS Lambda runtime
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  // pooled connection string for the app (serverless-safe)
  url       = env("DATABASE_URL")
  // direct (non-pooled) connection, used only by `prisma migrate`. Defaults to DATABASE_URL locally.
  directUrl = env("DIRECT_URL")
}

// ─────────────────────────────── Enums ───────────────────────────────

enum Environment {
  MANUAL
  PAPER
  LIVE
}

enum DataSource {
  MOCK
  LIVE
}

enum TokenStage {
  DISCOVERED
  SCANNED
  SAFETY_CHECK
  ANALYZED
  QUALIFIED
  SIGNAL_GENERATED
  FILTERED
}

enum RiskLevel {
  LOWER
  MODERATE
  HIGH
  CRITICAL
}

enum SignalType {
  BUY
  WATCH
  HOLD
  EXIT
}

enum SignalStatus {
  ACTIVE
  EXPIRED
  CONSUMED
}

enum BotStatus {
  ACTIVE
  PAUSED
  DISABLED
}

enum PositionStatus {
  OPEN
  TARGET_1
  TARGET_2
  TARGET_3
  PROFITABLE
  EMERGENCY
  CLOSED
}

enum PositionHealth {
  HOLD
  MONITOR
  WARNING
  EMERGENCY
}

enum TradeSide {
  BUY
  SELL
}

enum TradeKind {
  MANUAL_ENTRY
  AUTO_ENTRY
  TARGET_EXIT
  MANUAL_EXIT
  EMERGENCY_EXIT
}

enum TradeStatus {
  PREPARED
  PENDING
  CONFIRMED
  FAILED
  CANCELLED
  EXPIRED
}

enum TargetsMode {
  SINGLE
  MULTI
}

enum EventLevel {
  DEBUG
  INFO
  WARN
  ERROR
}

// ─────────────────────────────── Identity ───────────────────────────────

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String?
  passwordHash String
  role         String   @default("USER")
  createdAt    DateTime @default(now())

  wallets         Wallet[]
  tradingAccounts TradingAccount[]
  settings        TradingSettings?
  strategies      Strategy[]
  bot             Bot?
  positions       Position[]
  trades          Trade[]
  events          SystemEvent[]

  @@index([createdAt])
}

model Wallet {
  id         String   @id @default(cuid())
  userId     String
  chain      String   @default("solana")
  address    String
  label      String?
  verifiedAt DateTime @default(now())
  createdAt  DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([chain, address])
  @@index([userId])
}

/// One account per (user, environment). Environment scopes positions, trades and realised P/L.
model TradingAccount {
  id             String      @id @default(cuid())
  userId         String
  environment    Environment
  realizedPnlUsd Float       @default(0)
  createdAt      DateTime    @default(now())

  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  positions Position[]
  trades    Trade[]

  @@unique([userId, environment])
  @@index([userId])
}

model TradingSettings {
  id                   String      @id @default(cuid())
  userId               String      @unique
  environment          Environment @default(PAPER)
  autoTradingEnabled   Boolean     @default(false)
  capitalUsd           Float       @default(100)
  maxPositionUsd       Float       @default(10)
  minPositionUsd       Float       @default(5)
  maxOpenPositions     Int         @default(10)
  maxDeployedUsd       Float       @default(100)
  minOpportunityScore  Float       @default(70)
  minLiquidityUsd      Float       @default(100000)
  minVolume24hUsd      Float       @default(50000)
  maxPriceImpactPct    Float       @default(2)
  maxSlippageBps       Int         @default(300)
  maxAllowedRisk       RiskLevel   @default(MODERATE)
  targetsMode          TargetsMode @default(MULTI)
  maxPositionAgeHours  Int?
  emergencyEnabled     Boolean     @default(true)
  emergencyAutoExit    Boolean     @default(false)
  emergencyLiquidityDropPct Float  @default(70)
  /// Scanner filters (market-cap band etc.) validated with scannerFiltersSchema
  filters              Json        @default("{}")
  /// Opportunity-score weights validated with scoreWeightsSchema
  weights              Json        @default("{}")
  activeStrategyId     String?
  updatedAt            DateTime    @updatedAt

  user    User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  targets ProfitTarget[]
}

model ProfitTarget {
  id         String @id @default(cuid())
  settingsId String
  level      Int
  gainPct    Float
  /// percent of the *initial* position sold at this target (last target sells whatever remains)
  sellPct    Float

  settings TradingSettings @relation(fields: [settingsId], references: [id], onDelete: Cascade)

  @@unique([settingsId, level])
}

model Strategy {
  id          String   @id @default(cuid())
  userId      String
  name        String
  description String?
  config      Json
  isDefault   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// ─────────────────────────────── Market data ───────────────────────────────

model Token {
  id            String     @id @default(cuid())
  chain         String     @default("solana")
  address       String
  name          String
  symbol        String
  decimals      Int
  dex           String
  poolAddress   String?
  logoUrl       String?
  dataSource    DataSource
  stage         TokenStage @default(DISCOVERED)
  poolCreatedAt DateTime?
  firstSeenAt   DateTime   @default(now())
  lastScannedAt DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  // Latest denormalised metrics (source of truth for list queries/sorting)
  priceUsd         Float     @default(0)
  marketCapUsd     Float     @default(0)
  fdvUsd           Float     @default(0)
  liquidityUsd     Float     @default(0)
  volume24hUsd     Float     @default(0)
  volume1hUsd      Float     @default(0)
  change5m         Float     @default(0)
  change1h         Float     @default(0)
  change24h        Float     @default(0)
  buySellRatio     Float     @default(1)
  holders          Int       @default(0)
  holderGrowth1h   Float     @default(0)
  txCount1h        Int       @default(0)
  pairCount        Int       @default(1)
  opportunityScore Float     @default(0)
  riskLevel        RiskLevel @default(MODERATE)
  passedFilters    Boolean   @default(false)

  metrics    TokenMetric[]
  safety     TokenSafety?
  analysis   TokenAnalysis?
  pools      LiquidityPool[]
  prices     PriceSnapshot[]
  volumes    VolumeSnapshot[]
  signals    Signal[]
  positions  Position[]
  trades     Trade[]

  @@unique([chain, address])
  @@index([address])
  @@index([marketCapUsd])
  @@index([updatedAt])
  @@index([opportunityScore])
  @@index([passedFilters, marketCapUsd])
}

model TokenMetric {
  id           String   @id @default(cuid())
  tokenId      String
  ts           DateTime @default(now())
  priceUsd     Float
  marketCapUsd Float
  fdvUsd       Float
  liquidityUsd Float
  volume5m     Float
  volume15m    Float
  volume30m    Float
  volume1h     Float
  volume24h    Float
  buys5m       Int
  sells5m      Int
  buys1h       Int
  sells1h      Int
  holders      Int
  pairCount    Int

  token Token @relation(fields: [tokenId], references: [id], onDelete: Cascade)

  @@index([tokenId, ts])
}

model PriceSnapshot {
  id           String   @id @default(cuid())
  tokenId      String
  ts           DateTime @default(now())
  priceUsd     Float
  liquidityUsd Float

  token Token @relation(fields: [tokenId], references: [id], onDelete: Cascade)

  @@index([tokenId, ts])
}

model VolumeSnapshot {
  id       String   @id @default(cuid())
  tokenId  String
  ts       DateTime @default(now())
  volume5m Float
  volume1h Float
  volume24h Float
  buys5m   Int
  sells5m  Int

  token Token @relation(fields: [tokenId], references: [id], onDelete: Cascade)

  @@index([tokenId, ts])
}

model LiquidityPool {
  id             String   @id @default(cuid())
  tokenId        String
  chain          String   @default("solana")
  address        String
  dex            String
  quoteSymbol    String   @default("SOL")
  liquidityUsd   Float
  createdAtChain DateTime?
  updatedAt      DateTime @updatedAt

  token Token @relation(fields: [tokenId], references: [id], onDelete: Cascade)

  @@unique([chain, address])
  @@index([tokenId])
}

model TokenSafety {
  id             String    @id @default(cuid())
  tokenId        String    @unique
  riskScore      Float
  riskLevel      RiskLevel
  passed         Boolean
  warnings       Json
  criticalIssues Json
  details        Json
  checkedAt      DateTime  @default(now())

  token Token @relation(fields: [tokenId], references: [id], onDelete: Cascade)

  @@index([riskLevel])
}

model TokenAnalysis {
  id               String   @id @default(cuid())
  tokenId          String   @unique
  opportunityScore Float
  components       Json
  market           Json
  onchain          Json
  /// full TokenSnapshot + OnChainRaw used to rebuild the Analysis object for the signal engine
  snapshot         Json
  raw              Json
  computedAt       DateTime @default(now())
  updatedAt        DateTime @updatedAt

  token Token @relation(fields: [tokenId], references: [id], onDelete: Cascade)

  @@index([opportunityScore])
}

// ─────────────────────────────── Signals ───────────────────────────────

model Signal {
  id               String       @id @default(cuid())
  tokenId          String
  type             SignalType
  status           SignalStatus @default(ACTIVE)
  dataSource       DataSource
  score            Float
  opportunityScore Float
  riskLevel        RiskLevel
  priceUsd         Float
  entryMin         Float
  entryMax         Float
  target1          Float
  target2          Float
  target3          Float
  reasons          Json
  warnings         Json
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt
  expiresAt        DateTime

  token     Token           @relation(fields: [tokenId], references: [id], onDelete: Cascade)
  analysis  SignalAnalysis?
  positions Position[]

  @@index([createdAt])
  @@index([score])
  @@index([status, expiresAt])
  @@index([tokenId, status])
}

model SignalAnalysis {
  id         String   @id @default(cuid())
  signalId   String   @unique
  snapshot   Json
  ai         Json?
  aiProvider String?
  createdAt  DateTime @default(now())

  signal Signal @relation(fields: [signalId], references: [id], onDelete: Cascade)
}

// ─────────────────────────────── Bot ───────────────────────────────

model Bot {
  id                 String      @id @default(cuid())
  userId             String      @unique
  status             BotStatus   @default(PAUSED)
  environment        Environment @default(PAPER)
  lastRunAt          DateTime?
  emergencyStoppedAt DateTime?
  createdAt          DateTime    @default(now())
  updatedAt          DateTime    @updatedAt

  user User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  runs BotRun[]
}

model BotRun {
  id               String    @id @default(cuid())
  botId            String
  startedAt        DateTime  @default(now())
  finishedAt       DateTime?
  signalsEvaluated Int       @default(0)
  tradesExecuted   Int       @default(0)
  tradesSkipped    Int       @default(0)
  error            String?
  summary          Json?

  bot Bot @relation(fields: [botId], references: [id], onDelete: Cascade)

  @@index([botId, startedAt])
}

// ─────────────────────────────── Positions & trades ───────────────────────────────

model Position {
  id                 String         @id @default(cuid())
  userId             String
  accountId          String
  tokenId            String
  environment        Environment
  status             PositionStatus @default(OPEN)
  health             PositionHealth @default(HOLD)
  healthNotes        Json?
  origin             String         @default("MANUAL") // MANUAL | AUTO
  sourceSignalId     String?
  entryPriceUsd      Float
  currentPriceUsd    Float
  initialAmount      Float
  amount             Float // remaining tokens
  investedUsd        Float // total USD spent on entries
  costBasisUsd       Float // cost of the remaining tokens
  realizedPnlUsd     Float          @default(0)
  targetsHit         Int            @default(0)
  /// profit targets snapshotted at open so later settings edits do not alter live positions
  targetsSnapshot    Json
  emergencyEnabled   Boolean        @default(true)
  emergencyAutoExit  Boolean        @default(false)
  openedAt           DateTime       @default(now())
  updatedAt          DateTime       @updatedAt
  closedAt           DateTime?
  lastAnalysisAt     DateTime?

  user     User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  account  TradingAccount @relation(fields: [accountId], references: [id])
  token    Token          @relation(fields: [tokenId], references: [id])
  signal   Signal?        @relation(fields: [sourceSignalId], references: [id])
  events   PositionEvent[]
  trades   Trade[]

  @@index([userId, status])
  @@index([status])
  @@index([tokenId])
  @@index([openedAt])
}

model PositionEvent {
  id         String   @id @default(cuid())
  positionId String
  type       String
  message    String
  data       Json?
  createdAt  DateTime @default(now())

  position Position @relation(fields: [positionId], references: [id], onDelete: Cascade)

  @@index([positionId, createdAt])
}

model Trade {
  id             String      @id @default(cuid())
  userId         String
  accountId      String
  tokenId        String
  positionId     String?
  side           TradeSide
  kind           TradeKind
  environment    Environment
  dataSource     DataSource
  status         TradeStatus @default(PREPARED)
  inputUsd       Float
  tokenAmount    Float
  priceUsd       Float
  priceImpactPct Float
  slippageBps    Int
  feesUsd        Float       @default(0)
  networkFeeUsd  Float       @default(0)
  realizedPnlUsd Float?
  quote          Json
  failureReason  String?
  expiresAt      DateTime?
  createdAt      DateTime    @default(now())
  executedAt     DateTime?

  user        User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  account     TradingAccount @relation(fields: [accountId], references: [id])
  token       Token          @relation(fields: [tokenId], references: [id])
  position    Position?      @relation(fields: [positionId], references: [id])
  transaction Transaction?

  @@index([userId, createdAt])
  @@index([status])
  @@index([tokenId])
}

/// Only real on-chain transactions live here. Paper/simulated trades never get a Transaction row.
model Transaction {
  id          String    @id @default(cuid())
  tradeId     String    @unique
  chain       String    @default("solana")
  signature   String?   @unique
  status      String    @default("PENDING") // PENDING | CONFIRMED | FAILED
  unsignedTx  String?
  error       String?
  slot        BigInt?
  submittedAt DateTime?
  confirmedAt DateTime?
  createdAt   DateTime  @default(now())

  trade Trade @relation(fields: [tradeId], references: [id], onDelete: Cascade)
}

// ─────────────────────────────── Logging ───────────────────────────────

model SystemEvent {
  id        String     @id @default(cuid())
  ts        DateTime   @default(now())
  type      String
  level     EventLevel @default(INFO)
  source    String
  message   String
  userId    String?
  data      Json?

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([ts])
  @@index([type, ts])
  @@index([userId, ts])
}

/// Coordination row for background workers (heartbeat + last-run stats)
model WorkerState {
  name        String   @id
  lastRunAt   DateTime?
  lastError   String?
  leaseUntil  DateTime?
  runs        Int      @default(0)
  stats       Json?
  updatedAt   DateTime @updatedAt
}
